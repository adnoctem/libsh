root = true

[*.{sh,bats}]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true

# Standalone shell entry points have no .sh extension.
[bin/{install,libman,libtree}]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true

# Ignore paths
[test/bats/**]
ignore = true
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Planning notes and retired scripts, kept out of the tree but not linted
[secrets/**]
ignore = true
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
